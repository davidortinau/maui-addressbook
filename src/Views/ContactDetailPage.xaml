<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AddressBookPlus.ViewModels"
             x:Class="AddressBookPlus.Views.ContactDetailPage"
             x:DataType="viewmodels:ContactDetailViewModel"
             Title="Contact Details">
    
    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="16">
            
            <!-- Header Card -->
            <Border StyleClass="card,shadow,text-bg-primary" Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding Contact.FullName}" StyleClass="h2,on-primary" />
                    <Label Text="{Binding Contact.Title}" StyleClass="on-primary" />
                    <Label Text="{Binding Contact.Company}" StyleClass="on-primary" />
                </VerticalStackLayout>
            </Border>
            
            <!-- Address Card -->
            <Border StyleClass="card,shadow" Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Address" StyleClass="h5" />
                    <Label Text="{Binding FormattedAddress}" />
                </VerticalStackLayout>
            </Border>
            
            <!-- Phones Card -->
            <Border StyleClass="card,shadow" Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Phones" StyleClass="h5" />
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="80,*" RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding Contact.Phone1Label}" StyleClass="form-label" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Contact.Phone1}" />
                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding Contact.Phone2Label}" StyleClass="form-label" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Contact.Phone2}" />
                        <Label Grid.Row="2" Grid.Column="0" Text="{Binding Contact.Phone3Label}" StyleClass="form-label" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Contact.Phone3}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            
            <!-- Details Card -->
            <Border StyleClass="card,shadow" Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Details" StyleClass="h5" />
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="100,*" RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="0" Text="Profession" StyleClass="form-label" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Contact.Profession}" />
                        <Label Grid.Row="1" Grid.Column="0" Text="Birthday" StyleClass="form-label" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Contact.Birthday, StringFormat='{0:MMM d, yyyy}'}" />
                        <Label Grid.Row="2" Grid.Column="0" Text="{Binding Contact.CustomFieldLabel}" StyleClass="form-label" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Contact.CustomFieldValue}" />
                        <Label Grid.Row="3" Grid.Column="0" Text="Notes" StyleClass="form-label" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding Contact.Notes}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            
            <!-- Action Buttons -->
            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Button Text="Edit" StyleClass="btn-primary" 
                        SemanticProperties.Description="Edit contact"
                        Command="{Binding EditCommand}" />
                <Button Text="Delete" StyleClass="btn-outline-danger" 
                        SemanticProperties.Description="Delete contact"
                        Command="{Binding DeleteCommand}" />
                <Button Text="Copy Address" StyleClass="btn-outline-secondary" 
                        SemanticProperties.Description="Copy contact address"
                        Command="{Binding CopyAddressCommand}" />
            </HorizontalStackLayout>
            
        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>